{
  "Comment": "One execution per run. Acquires the environment wide semaphore, launches the plan task and waits for the runner to report, waits for a confirmation when the run needs one, launches the apply task, then releases the semaphore and marks the run.",
  "StartAt": "AcquireSemaphore",
  "QueryLanguage": "JSONPath",
  "States": {
    "AcquireSemaphore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id": { "S": "run-semaphore" } },
        "UpdateExpression": "ADD holders :holder",
        "ConditionExpression": "attribute_not_exists(holders) OR size(holders) < :cap",
        "ExpressionAttributeValues": {
          ":holder": { "SS.$": "States.Array($.run_id)" },
          ":cap": { "N": "${SemaphoreCap}" }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "IntervalSeconds": 15,
          "MaxAttempts": 240,
          "BackoffRate": 1,
          "MaxDelaySeconds": 60
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "ResultPath": null,
      "Next": "Plan",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkErroredWithoutSemaphore"
        }
      ]
    },

    "Plan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "Parameters": {
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${PlanTaskDefinitionArn}",
        "LaunchType": "FARGATE",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${SubnetIdsJson},
            "SecurityGroups": ${SecurityGroupIdsJson},
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${PlanContainerName}",
              "Environment": [
                { "Name": "RUN_ID", "Value.$": "$.run_id" },
                { "Name": "WORKSPACE_ID", "Value.$": "$.workspace_id" },
                { "Name": "PHASE", "Value": "plan" },
                { "Name": "TASK_TOKEN", "Value.$": "$$.Task.Token" },
                { "Name": "API_BASE_URL", "Value": "${ApiBaseUrl}" }
              ]
            }
          ]
        }
      },
      "TimeoutSeconds": ${PlanTimeoutSeconds},
      "HeartbeatSeconds": 600,
      "ResultPath": "$.plan",
      "Next": "PlanOutcome",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkErrored"
        }
      ]
    },

    "PlanOutcome": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.plan_only",
          "BooleanEquals": true,
          "Next": "MarkPlannedAndFinished"
        },
        {
          "And": [
            { "Variable": "$.plan.changes.add", "NumericEquals": 0 },
            { "Variable": "$.plan.changes.change", "NumericEquals": 0 },
            { "Variable": "$.plan.changes.destroy", "NumericEquals": 0 }
          ],
          "Next": "MarkPlannedAndFinished"
        }
      ],
      "Default": "AwaitConfirmation"
    },

    "AwaitConfirmation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem.waitForTaskToken",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id.$": "$.run_id" },
        "UpdateExpression": "SET #status = :status, confirm_task_token = :token",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "awaiting_confirmation" },
          ":token": { "S.$": "$$.Task.Token" }
        }
      },
      "TimeoutSeconds": ${ConfirmationTimeoutSeconds},
      "ResultPath": "$.confirmation",
      "Next": "Apply",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkErrored"
        }
      ]
    },

    "Apply": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "Parameters": {
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${ApplyTaskDefinitionArn}",
        "LaunchType": "FARGATE",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ${SubnetIdsJson},
            "SecurityGroups": ${SecurityGroupIdsJson},
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${ApplyContainerName}",
              "Environment": [
                { "Name": "RUN_ID", "Value.$": "$.run_id" },
                { "Name": "WORKSPACE_ID", "Value.$": "$.workspace_id" },
                { "Name": "PHASE", "Value": "apply" },
                { "Name": "TASK_TOKEN", "Value.$": "$$.Task.Token" },
                { "Name": "API_BASE_URL", "Value": "${ApiBaseUrl}" }
              ]
            }
          ]
        }
      },
      "TimeoutSeconds": ${ApplyTimeoutSeconds},
      "HeartbeatSeconds": 600,
      "ResultPath": "$.apply",
      "Next": "MarkApplied",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "MarkErrored"
        }
      ]
    },

    "MarkApplied": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id.$": "$.run_id" },
        "UpdateExpression": "SET #status = :status REMOVE confirm_task_token",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": { ":status": { "S": "applied" } }
      },
      "ResultPath": null,
      "Next": "ReleaseSemaphore"
    },

    "MarkPlannedAndFinished": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id.$": "$.run_id" },
        "UpdateExpression": "SET #status = :status REMOVE confirm_task_token",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": { ":status": { "S": "planned_and_finished" } }
      },
      "ResultPath": null,
      "Next": "ReleaseSemaphore"
    },

    "MarkErrored": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id.$": "$.run_id" },
        "UpdateExpression": "SET #status = :status REMOVE confirm_task_token",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": { ":status": { "S": "errored" } }
      },
      "ResultPath": null,
      "Next": "ReleaseSemaphoreAfterFailure"
    },

    "MarkErroredWithoutSemaphore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id.$": "$.run_id" },
        "UpdateExpression": "SET #status = :status",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": { ":status": { "S": "errored" } }
      },
      "ResultPath": null,
      "Next": "Failed"
    },

    "ReleaseSemaphore": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id": { "S": "run-semaphore" } },
        "UpdateExpression": "DELETE holders :holder",
        "ExpressionAttributeValues": {
          ":holder": { "SS.$": "States.Array($.run_id)" }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "ResultPath": null,
      "End": true
    },

    "ReleaseSemaphoreAfterFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${RunsTable}",
        "Key": { "run_id": { "S": "run-semaphore" } },
        "UpdateExpression": "DELETE holders :holder",
        "ExpressionAttributeValues": {
          ":holder": { "SS.$": "States.Array($.run_id)" }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "ResultPath": null,
      "Next": "Failed"
    },

    "Failed": {
      "Type": "Fail",
      "Error": "RunFailed",
      "Cause": "The run did not complete. Its item on the runs table carries the errored status and the run logs carry the phase output."
    }
  }
}
